# VidyaTrack frontend development environment

VITE_BUILD_ENVIRONMENT=dev
VITE_FALLBACK_ENVIRONMENT=dev

VITE_APP_HOST_DEV=vidyatrack-dev.vercel.app
VITE_APP_HOST_STAGE=vidyatrack-stage.vercel.app
VITE_APP_HOST_PROD=vidyatrack.vercel.app

VITE_API_BASE_URL_DEV=https://vidyatrack-api-dev.onrender.com
VITE_API_BASE_URL_STAGE=https://vidyatrack-api-stage.onrender.com
VITE_API_BASE_URL_PROD=https://vidyatrack-api.onrender.com

VITE_LOCAL_API_PROXY_TARGET=http://127.0.0.1:8000

VITE_FEATURE_PLATFORM_MANAGEMENT_DEV=true
VITE_FEATURE_PLATFORM_MANAGEMENT_STAGE=true
VITE_FEATURE_PLATFORM_MANAGEMENT_PROD=true

VITE_FEATURE_TEACHER_COMMUNICATIONS_DEV=true
VITE_FEATURE_TEACHER_COMMUNICATIONS_STAGE=true
VITE_FEATURE_TEACHER_COMMUNICATIONS_PROD=true

VITE_FEATURE_STUDENT_NOTES_DEV=true
VITE_FEATURE_STUDENT_NOTES_STAGE=true
VITE_FEATURE_STUDENT_NOTES_PROD=true
